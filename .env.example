# Local/LAN deployment:
BIND_ADDRESS=0.0.0.0
APP_PORT=8080
NODE_ENV=production
TRUST_PROXY=0
PUBLIC_ORIGINS=
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FEEDBACK_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=

