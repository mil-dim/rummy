# Local/LAN deployment:
BIND_ADDRESS=0.0.0.0
APP_PORT=8080
NODE_ENV=production
TRUST_PROXY=0
PUBLIC_ORIGINS=
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BOT_TOKEN=
BOT_NAME=Tabletop Bot
BOT_COUNT=1
BOT_ENGINE=heuristic
BOT_AI_PROVIDER=openai
BOT_AI_MODEL=gpt-6-luna
OPENAI_API_KEY=
BOT_AI_MAX_REQUESTS_PER_DAY=200
BOT_AI_TIMEOUT_MS=8000
BOT_AI_MAX_OUTPUT_TOKENS=256
# For a private Ollama server, set BOT_AI_PROVIDER=ollama and a suitable model:
# OLLAMA_URL=http://private-host:11434

# Public deployment behind a local reverse proxy:
# BIND_ADDRESS=127.0.0.1
# APP_PORT=8080
# TRUST_PROXY=1
# PUBLIC_ORIGINS=https://play.example.com
# PUBLIC_BASE_URL=https://play.example.com
